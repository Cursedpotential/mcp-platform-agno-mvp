{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.evidence-platform.internal/import/v1/hash-receipt.schema.json",
  "title": "HashReceipt (v1)",
  "description": "A version-1 integrity receipt. New context intake emits context_source_fingerprint, context_raw_record_fingerprint, or context_raw_generation_fingerprint; these are not custody H1/H2/H3. The original h1_source/raw_record_digest/h3_raw_generation values remain accepted for backward-compatible decoding of already persisted v1 receipts only. Normalized digests retain their existing names. Verification is a separate ReconciliationReceipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "hash_receipt_id", "activity_receipt_ref", "hash_kind", "algorithm", "digest", "subject_ref", "construction", "computed_at", "computed_by"],
  "properties": {
    "contract_version": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "hash_receipt_id": { "$ref": "common.schema.json#/$defs/RecordId" },
    "activity_receipt_ref": {
      "$ref": "common.schema.json#/$defs/RecordId",
      "description": "The successful ActivityReceipt whose exact result_ref points back to this hash_receipt_id."
    },
    "hash_kind": {
      "type": "string",
      "enum": ["h1_source", "raw_record_digest", "h3_raw_generation", "context_source_fingerprint", "context_raw_record_fingerprint", "context_raw_generation_fingerprint", "normalized_record_digest", "normalized_generation_manifest_digest"]
    },
    "algorithm": { "type": "string", "enum": ["sha256"] },
    "digest": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "description": "The exact source/generation/record subject. Legacy h1_source/raw_record_digest/h3_raw_generation receipts retain their original v1 subject meanings."
    },
    "construction": {
      "type": "string",
      "minLength": 1,
      "description": "Names the exact context fingerprint or normalized digest construction. Context raw records use context-rawrecord-fingerprint-v1 or context-rawspan-fingerprint-v1 and never custody H2 canons."
    },
    "ordered_member_digests": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
      "description": "Inline membership is allowed only for bounded manifests. For context_raw_generation_fingerprint these are ordered context_raw_record_fingerprint values; for normalized_generation_manifest_digest these are ordered normalized_record_digest values."
    },
    "ordered_member_manifest_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Compact reference to the durably persisted ordered membership for large generations. This is preferred over carrying an unbounded digest array through Temporal history."
    },
    "computed_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "computed_by": {
      "type": "string",
      "minLength": 1,
      "description": "The exact universal-import Activity name that computed this hash."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "hash_kind": { "const": "context_source_fingerprint" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "const": "context-source-fingerprint-v1" }, "computed_by": { "enum": ["fingerprint_source_activity", "hash_source_activity"] } } }
    },
    {
      "if": { "properties": { "hash_kind": { "const": "context_raw_record_fingerprint" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "enum": ["context-rawrecord-fingerprint-v1", "context-rawspan-fingerprint-v1"] }, "computed_by": { "enum": ["fingerprint_raw_records_activity", "hash_raw_records_activity"] } } }
    },
    {
      "if": { "properties": { "hash_kind": { "const": "context_raw_generation_fingerprint" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "const": "context-rawgen-fingerprint-chain-v1" }, "computed_by": { "enum": ["fingerprint_raw_generation_activity", "hash_raw_generation_activity"] } } }
    },
    {
      "if": { "properties": { "hash_kind": { "const": "h1_source" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "const": "h1-rawbytes-v1" }, "computed_by": { "const": "hash_source_activity" } } }
    },
    {
      "if": { "properties": { "hash_kind": { "const": "raw_record_digest" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "enum": ["h2-rawelement-v1", "h2-rawrecord-v1", "h2-rawspan-v1"] }, "computed_by": { "const": "hash_raw_records_activity" } } }
    },
    {
      "if": { "properties": { "hash_kind": { "const": "h3_raw_generation" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "const": "h3-chain-platform-rawall-genesisempty-v1" }, "computed_by": { "const": "hash_raw_generation_activity" } } }
    },
    {
      "if": { "properties": { "hash_kind": { "const": "normalized_record_digest" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "const": "normalized-record-postgresql18-jsonb-text-utf8-sha256-v1" }, "computed_by": { "const": "hash_normalized_records_activity" } } }
    },
    {
      "if": { "properties": { "hash_kind": { "const": "normalized_generation_manifest_digest" } }, "required": ["hash_kind"] },
      "then": { "properties": { "construction": { "const": "normalized-generation-ordered-digests-lengthframed-sha256-v1" }, "computed_by": { "const": "hash_normalized_generation_activity" } } }
    }
  ],
  "if": {
    "properties": { "hash_kind": { "enum": ["h3_raw_generation", "context_raw_generation_fingerprint", "normalized_generation_manifest_digest"] } },
    "required": ["hash_kind"]
  },
  "then": {
    "oneOf": [
      { "required": ["ordered_member_digests"] },
      { "required": ["ordered_member_manifest_ref"] }
    ]
  }
}
