# Force LF on shell scripts and text the container executes — Windows authoring
# must never reintroduce CRLF (breaks `#!/bin/bash` shebangs in Linux containers).
*.sh    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
Dockerfile text eol=lf
*.env   text eol=lf
* text=auto

# Normalize additional source/text formats to LF in the repository.
*.go    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf

# Binary formats — never diff or normalize.
*.png    binary
*.jpg    binary
*.zip    binary
*.duckdb binary
*.pdf    binary
