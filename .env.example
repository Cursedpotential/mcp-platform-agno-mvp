# -- Model Provider (set at least one API key) ----------------
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_ID=gpt-4o
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=gsk_...
# OLLAMA_BASE_URL=http://localhost:11434

# -- Database -------------------------------------------------
PLATFORM_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agno_platform

# Database connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# -- Knowledge ------------------------------------------------
KNOWLEDGE_BASE_PATH=./knowledge/platform

# -- MCP Server Commands --------------------------------------
# These point to your existing MCP_PLATFORM MCP servers
TS_MCP_COMMAND=node /app/mcp-servers/ts-mcp-server/dist/index.js
PY_MCP_COMMAND=python /app/mcp-servers/py-mcp-server/main.py
# JS_MCP_COMMAND=node /app/mcp-servers/js-mcp-server/dist/index.js

# -- MCP Server URLs (for containerized HTTP communication) ----
# Used when MCP servers run as separate Docker services.
# Set these when using docker-compose; leave unset for local stdio mode.
TS_MCP_SERVER_URL=http://ts-mcp-server:3001
PY_MCP_SERVER_URL=http://py-mcp-server:3002

# -- Human-in-the-Loop ----------------------------------------
HITL_REQUIRE_APPROVAL=true
HITL_APPROVAL_TIMEOUT_SECONDS=3600

# -- API ------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
