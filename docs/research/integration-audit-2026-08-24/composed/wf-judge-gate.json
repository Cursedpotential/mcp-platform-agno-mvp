    {
      "parameters": {
        "jsCode": "// Split the judged rows into the TWO outputs this activity promises.\n// ANTI-OVER-FLAGGING (owner rule): there is no \"flagged\" bucket here.\n// Anything that fails the gate goes to needs_review = UNREVIEWED. It is not a finding,\n// not an alert, and nothing downstream may treat it as one.\nconst rows = $input.all().map(i => i.json);\nconst accepted = rows.filter(r => r.gate_outcome === 'accepted');\nconst needsReview = rows.filter(r => r.gate_outcome !== 'accepted');\nconst now = Date.now();\nreturn [{ json: {\n  activity_name: 'n8n.judge.gate',\n  status: 'completed',\n  batch_id: rows.length ? rows[0].batch_id : null,\n  threshold: rows.length ? rows[0].threshold : null,\n  counts: { total: rows.length, accepted: accepted.length, needs_review: needsReview.length },\n  completed_at_epoch_ms: now,\n  completed_at_iso: new Date(now).toISOString(),\n  accepted: accepted,\n  needs_review: needsReview,\n}}];\n"
      },
      "id": "051a9e40-0000-0000-0000-00000000005c",
      "name": "Split accepted / needs_review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
