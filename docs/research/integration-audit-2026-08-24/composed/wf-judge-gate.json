      "id": "051a9e40-0000-0000-0000-000000000031",
      "name": "Webhook - judge gate",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -520,
        -80
      ],
      "webhookId": "56ca707d-7648-434f-b55d-a7cc308e9349"
    },
    {
      "parameters": {
        "jsCode": "// Webhook body -> one item per classification result awaiting judgement.\n// Expected POST body:\n//   { \"batch_id\": \"...\", \"threshold\": 0.7, \"items\":\n//       [ { \"record_id\",\"chunk_id\",\"chunk_text\",\"labels\",\"severity\",\"summary\",\"sentiment\",\n//           \"occurred_at_epoch_ms\",\"classifier_version\" }, ... ] }\nconst body = $input.first().json.body || $input.first().json || {};\nconst items = body.items || [];\nif (!Array.isArray(items) || items.length === 0) {\n  throw new Error('judge-gate: body.items must be a non-empty array of classification results');\n}\nconst now = Date.now();\n// {{THRESHOLD}} - default 0.7. Caller may override per batch; deploy may hard-code it here.\nconst threshold = Number(body.threshold != null ? body.threshold : 0.7);\n\nreturn items.map((it, i) => ({ json: Object.assign({}, it, {\n  batch_id: body.batch_id || ('judge-' + now),\n  batch_index: i,\n  threshold: threshold,\n  judged_at_epoch_ms: now,\n  judged_at_iso: new Date(now).toISOString(),\n  activity_name: 'n8n.judge.gate',\n})}));\n"
      },
      "id": "051a9e40-0000-0000-0000-000000000032",
      "name": "Normalize Classification Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
