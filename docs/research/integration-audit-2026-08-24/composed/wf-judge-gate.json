    {
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=CHUNK (occurred {{ $json.occurred_at_iso }} / epoch ms {{ $json.occurred_at_epoch_ms }}):\n{{ $json.chunk_text }}\n\nDRAFT CLASSIFICATION produced by classifier_version {{ $json.classifier_version }}:\nlabels: {{ JSON.stringify($json.labels) }}\nseverity: {{ $json.severity }}\nsummary: {{ $json.summary }}\nsentiment: {{ $json.sentiment }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an independent reviewer. You did NOT write the draft classification.\nDecide whether the draft is SUPPORTED BY THE CHUNK TEXT ALONE.\nJudge only against information available at or before the chunk timestamp.\nReport your calibrated confidence in your own verdict. If you are unsure, report LOW confidence - a low score routes the item to an unreviewed queue, which is the correct and harmless outcome. Never inflate confidence."
            }
          ]
        }
      },
