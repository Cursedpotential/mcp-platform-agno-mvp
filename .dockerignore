.DS_Store

.git

# Cache
.mypy_cache
.ruff_cache
.pytest_cache
*__pycache__*
*.egg-info
*.pyc

# Machine specific
.idea
.vscode

# Ignore .env files
.env
.env.production
.envrc

# ignore virtualenvs
.venv
venv*
aienv*

.ipynb_checkpoints

# Project-specific
tmp/
.claude/

# Vendored SBV — build artifacts are produced INSIDE the image (stages 1-3),
# never copied from the build context. Keep them out of the root context that
# platform-tools (and agentos-api) upload.
vendored/sbv/frontend/node_modules
vendored/sbv/frontend/dist
vendored/sbv/sbv
vendored/sbv/**/*.db
vendored/sbv/**/*.db-shm
vendored/sbv/**/*.db-wal

# 2026-09-02: build context moved to repo root (deploy/*.yaml context: ..) - exclude nested repos + bulk
modules/forks/
modules/custom/
modules/traceIQ/
modules/Legal-Workspace/
modules/apps/
modules/workbench/web/node_modules/
docs/
tests/
