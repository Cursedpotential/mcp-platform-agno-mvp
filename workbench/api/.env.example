# Byline: Claude Code · Sonnet (agent) · 2026-07-19
# See compose.workbench.yaml for the deployed values (Coolify renders these
# as literals — env changes need a redeploy).

# S3-compatible object store: R2 today, B2/AWS/any-S3 = pure env swap
OBJECT_STORE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORE_BUCKET=your-bucket-name
OBJECT_STORE_ACCESS_KEY_ID=your_access_key_id
OBJECT_STORE_SECRET_ACCESS_KEY=your_secret_access_key
OBJECT_STORE_REGION=auto
OBJECT_STORE_PREFIX=workbench/staging

# LanceDB local whole-file staging store
LANCEDB_PATH=/data/lancedb

# Existing platform ingestion API (the promote target)
AGENTOS_API_URL=http://100.72.169.40:8000
# AGENTOS_API_TOKEN=optional_bearer_token

APP_PORT=8020
STATIC_DIR=/app/static
MAX_UPLOAD_MB=200
