# Byline: Claude Code · Sonnet (agent) · 2026-07-19
# See compose.workbench.yaml for the deployed values (Coolify renders these
# as literals — env changes need a redeploy).

# S3-compatible object store: R2 today, B2/AWS/any-S3 = pure env swap
OBJECT_STORE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORE_BUCKET=your-bucket-name
OBJECT_STORE_ACCESS_KEY_ID=your_access_key_id
OBJECT_STORE_SECRET_ACCESS_KEY=your_secret_access_key
OBJECT_STORE_REGION=auto
OBJECT_STORE_PREFIX=workbench/staging

# LanceDB local whole-file staging store
LANCEDB_PATH=/data/lancedb

# Existing platform ingestion API (the promote target + the /v1/runs spine)
AGENTOS_API_URL=http://100.72.169.40:8000
# AGENTOS_API_TOKEN=optional_bearer_token

# Mandatory inbound Workbench credential. Use a long random value. API callers
# send it as a Bearer token; browsers use Basic auth with username "owner".
# Only the exact /health path is exempt.
WORKBENCH_API_KEY=replace_with_a_long_random_secret

# MCP tool servers for the Tool Explorer — json array of {key,label,url,token?}.
# See app/config/settings.py for the ContextForge auth caveat (JWT required,
# not "no auth on tailnet" as originally assumed).
# agentos-mcp (:8001) retired 2026-07-23 — use agentos-api's mounted :8000/mcp.
# MCP_SERVERS=[{"key":"agentos","label":"AgentOS","url":"http://100.72.169.40:8000/mcp"},{"key":"contextforge","label":"ContextForge","url":"http://100.72.169.40:4444/mcp"}]
# CONTEXTFORGE_TOKEN=optional_minted_jwt

APP_PORT=8020
STATIC_DIR=/app/static
MAX_UPLOAD_MB=200
