evidence/config/case_terms.yaml

# Infra doc with real credentials — commit only the sanitized .template.md
docs/INFRASTRUCTURE.md

# gateway content-addressed result store (runtime artifacts, never committed)
data/content_store/

# context-chat-ingest local dedup ledger (runtime state, never committed)
data/context_ingest/

# build artifacts + local analysis scratch (untracked lanes)
*.egg-info/
.osgrep/
analytics/
# live-DB dumps (may contain sealed values) — NEVER commit
live-dumps/

# env backups (live secrets) — NEVER commit
.env.bak*
# chat-sample breakdowns (real case PII; owner rule 2026-07-11: local + gitignored)
docs/planning/chat-sample-analysis/
