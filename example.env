# =============================================================================
# agno-mvp environment — copy to .env and fill in.  (.env is gitignored)
# Provider-agnostic model factory (ADR-0008); active provider = Ollama Cloud (D7 rev).
# =============================================================================

# --- Model provider (ACTIVE: Ollama Cloud) -----------------------------------
# Ollama Cloud: set OLLAMA_API_KEY to enable cloud (host auto-sets to https://ollama.com).
# Local: set OLLAMA_HOST instead (e.g. http://localhost:11434).
OLLAMA_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# Optional: pin a specific model id (else per-provider default is used)
# DEFAULT_MODEL_ID=glm-5.1
# Optional: force a provider instead of auto-selecting by available keys
# DEFAULT_MODEL_PROVIDER=ollama

# --- Backup providers (selected if their key is set) ---------------------------
# NVIDIA NIM (OpenAI-compatible, backup provider)
# NVIDIA_API_KEY=nvapi-***
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# ANTHROPIC_API_KEY=          # pinned ids: claude-opus-4-8 / claude-sonnet-4-6
# OPENAI_API_KEY=             # also needed for default Knowledge embeddings (see below)
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Embeddings (symmetric, OpenAI-compatible /embeddings) -------------------
# CANONICAL knobs (server/core/session.py): EMBED_BASE_URL + EMBED_API_KEY select
# the provider; EMBED_TEXT_ID/DIM the model. Falls back to OPENROUTER_* if unset.
# LIVE since 2026-07-19: NVIDIA NIM nv-embed-v1 (4096-d, free, symmetric) after
# OpenRouter bge-m3 died on 402/no-credits. WRONG DIM = drop + re-create the
# vector collection. Don't change after first boot without re-embedding.
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBED_API_KEY=            # NVIDIA_API_KEY value
EMBED_TEXT_ID=nvidia/nv-embed-v1
EMBED_TEXT_DIM=4096

# --- LEGACY NIM asymmetric embedder (NimEmbedder fallback shim only — do NOT
# use as the platform text embedder; asymmetric embedqa degrades retrieval) ----
# Embedder: llama-nemotron-embed-vl-1b-v2 (multimodal text+image, 2048-d — verified 2026-06-07)
# NIM params: input_type="passage" for indexing, "query" for search; modality=["text"]
# WRONG DIM = must drop + re-create the vector table. Don't change after first boot.
# NVIDIA_EMBED_TEXT_ID=nvidia/llama-nemotron-embed-vl-1b-v2
# NVIDIA_EMBED_TEXT_DIM=2048
# Code embedder (verify dim before first use):
# NVIDIA_EMBED_CODE_ID=nvidia/nv-embedcode-7b-v1
# NVIDIA_EMBED_CODE_DIM=4096
# Reranker:
# NVIDIA_RERANK_ID=nvidia/nv-rerankqa-mistral-4b-v3

# --- Database (Postgres; defaults match docker compose) ----------------------
# Prefer a full URL, or set the DB_* parts.
# PLATFORM_DB_URL=postgresql+psycopg://ai:ai@postgres:5432/ai
DB_DRIVER=postgresql+psycopg
DB_HOST=postgres
DB_PORT=5432
DB_USER=ai
DB_PASS=ai
DB_DATABASE=ai

# --- AgentOS / runtime -------------------------------------------------------
RUNTIME_ENV=dev                 # dev enables reload ONLY when no MCPTools attached
# AGENTOS_URL=http://127.0.0.1:8000
# JWT_VERIFICATION_KEY=         # required when RUNTIME_ENV=prd (RBAC)

# --- HITL --------------------------------------------------------------------
HITL_REQUIRE_APPROVAL=true
HITL_APPROVAL_TIMEOUT_SECONDS=3600

# --- MCP tool servers (vendored from MCP_PLATFORM) ---------------------------
TS_MCP_COMMAND=node mcp-servers/ts-mcp-server/dist/index.js
PY_MCP_COMMAND=python mcp-servers/py-mcp-server/src/server.py
# JS_MCP_COMMAND=node mcp-servers/js-mcp-server/src/index.js
# MCP Toolbox for Databases (DB fleet) — http URL (auto-appends /mcp)
# TOOLBOX_URL=http://toolbox:5000

# --- Cloudflare R2 (blob/object landing zone, ADR-0007/0030) -----------------
# R2_ACCOUNT_ID is REQUIRED for the pg_duckdb S3 secret: ensure_duckdb_r2_secret()
# builds the endpoint as {R2_ACCOUNT_ID}.r2.cloudflarestorage.com and returns
# False (silently — no SQL/forensic R2 reads) if it is unset. (ADR-0030.)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=

# --- n8n (automation; shares Postgres, isolated DB) --------------------------
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai
POSTGRES_DB=ai
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=
TIMEZONE=America/Detroit
PUID=1000
PGID=1000

# --- Google Drive READ (one credential per account; corpora=user) ------------
# GOOGLE_SA_FILE_PERSONAL=/secrets/gdrive_personal.json
# GOOGLE_SA_FILE_WORK=/secrets/gdrive_work.json
# Drive WRITE/cleanup (third-party MCP, trash-only) — per account
# DRIVE_CLEANUP_MCP_URL=http://gdrive-mcp:PORT

# --- OneDrive (MCP per Microsoft account; MrFixit96 server) ------------------
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT_ID=
# ONEDRIVE_MCP_URL_PERSONAL=http://onedrive-mcp-personal:PORT
# ONEDRIVE_CLEANUP_MCP_URL=http://onedrive-mcp:PORT   # Files.ReadWrite, trash-only

# --- Slack (optional interface; OFF by Non-Goals unless both set) ------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GRAPH TIER — verified live 2026-08-29 (DECISION_LOG D-106 / D-107)
# Neo4j/DozerDB runs on the SAME host as PostgreSQL and Weaviate.
# The old OVH3_HOST address 100.119.96.29 is a RETIRED-GRAPHITI artifact and
# does not answer. Do not use it.
NEO4J_URI=bolt://100.91.190.107:7687
NEO4J_HTTP=http://100.91.190.107:7474
NEO4J_USER=neo4j
# NEO4J_PASSWORD is set separately. NOTE: auth persists in the data volume, so
# NEO4J_AUTH in compose no longer governs it. Rotation is outstanding.
#
# LIVE graph databases — write here:
NEO4J_DB_SEMANTICA=evidence
NEO4J_DB_SAT_TEMPORAL=sat-temporal
# ^ 'sat-temporal' with a DASH. Neo4j rejects underscores in database names,
#   so D-093's 'sat_temporal' spelling is invalid and can never be created.
#
# RETIRED graph databases — READ ONLY BY CONVENTION, never write:
NEO4J_DB_GRAPHITI_ARCHIVE=memory
NEO4J_DB_GRAPHITI_ARCHIVE_DEFAULT=neo4j
# ^ Graphiti retired 2026-08-27 (D-095). Preserved because the extractions may
#   still be useful. DozerDB supports neither database rename nor SET ACCESS
#   READ ONLY, so each carries a :_RETIRED_GRAPHITI_ARCHIVE marker node instead.
# ─────────────────────────────────────────────────────────────────────────────
