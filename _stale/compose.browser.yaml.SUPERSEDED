# =============================================================================
# BROWSER TIER — in-VPS Chromium (linuxserver/chromium) so os.agno.com's FREE
# tier works against the platform. The full AgentOS CONTROL PLANE (agents/teams/
# knowledge/sessions/memory/metrics/evals/traces/scheduler) is os.agno.com's
# proprietary app — NOT in the open-source agent-ui. os.agno.com free only
# connects to a LOCAL endpoint, so we run the browser ON the VPS and bridge the
# platform to its localhost:8000.
#
# Flow: you -> https://browser.mitechconsult.com (Traefik + basic auth) -> this
# Chromium -> os.agno.com -> http://localhost:8000 (+ OS_SECURITY_KEY) -> platform.
#
# The bridge is a tiny socat SIDECAR sharing the browser's network namespace
# (network_mode: service:browser), so its 127.0.0.1:8000 IS the browser's
# localhost — no image modification, no custom-init fragility. socat forwards to
# 100.72.169.40:8000 = agentos-api published on the OVH-1 tailnet IP (reachable
# from any container on the box; verified 200).
#
# Own Coolify app (isolated from exec-tier). No build — pulls images directly.
# HOST-PREP: sudo mkdir -p /data/agno/volumes/browser_config && sudo chown -R 1000:1000 /data/agno/volumes/browser_config
#
# PORTED TO main 2026-08-06 from hotfix/agent-ui-lockfile, which was this file's
# only home. The BRANCH is not merged and must not be — its compose.exec.yaml
# pins ContextForge 0.8.0 while main runs v1.0.4, so merging would roll the
# gateway back. This file is self-contained (pulled images + one bind mount, no
# repo dependencies), so porting it is sufficient.
#
# ⚠ WHEN REPOINTING THE COOLIFY APP TO main, SET watch_paths FIRST.
# It is currently None, which is harmless on a quiet branch but means "redeploy
# on EVERY push" — and 19 apps push to main. Set: compose.browser.yaml
# =============================================================================
# Byline: Claude Code · Opus 5 · 2026-08-06 (port to main + digest pins)

services:
  browser:
    # Pinned by digest — no floating tags on production. This is the image that
    # has been running for 4 weeks, so a redeploy is image-identical.
    image: lscr.io/linuxserver/chromium@sha256:5f51b7298c617e8359a5fcb1b69e3ff53dc082d22b4d0d01c6367d5145090574
    container_name: agno-browser
    restart: unless-stopped
    security_opt:
      - seccomp:unconfined          # Chromium sandbox needs this under Docker
    shm_size: "1gb"                  # Chromium shared memory (avoids tab crashes)
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: America/Detroit
      CHROME_CLI: https://os.agno.com   # auto-open the control plane on launch
    volumes:
      - /data/agno/volumes/browser_config:/config
    labels:
      - traefik.enable=true
      - traefik.http.routers.browser.rule=Host(`browser.mitechconsult.com`)
      - traefik.http.routers.browser.entryPoints=https
      - traefik.http.routers.browser.tls=true
      - traefik.http.routers.browser.tls.certresolver=letsencrypt
      - traefik.http.routers.browser.service=browser
      - traefik.http.routers.browser.middlewares=browser-auth
      # basic auth gate (apr1, SINGLE '$' — Coolify passes labels verbatim).
      # user: matt
      #
      # ⚠ DO NOT "fix" this to '$$'. Verified live 2026-08-06: `docker compose
      # config` interpolates $apr1/$baWBjon1/$CeRCrbBEl as empty vars and renders
      # the label as `matt:/8SEglAHlfTu1` — a mangled hash no password matches.
      # The RUNNING container has the full correct value, because Coolify does not
      # run that interpolation on labels. So single-'$' is right HERE and wrong
      # under plain `docker compose up`. If this file is ever deployed outside
      # Coolify, double the '$' at that point — and expect a lockout on
      # browser.mitechconsult.com if you forget (fail-closed, not an auth bypass).
      - traefik.http.middlewares.browser-auth.basicauth.users=matt:$apr1$baWBjon1$CeRCrbBEl/8SEglAHlfTu1
      - traefik.http.services.browser.loadbalancer.server.port=3000   # KasmVNC web (http)

  # socat bridge: shares the browser's network namespace so 127.0.0.1:8000 inside
  # the browser reaches the platform. No Traefik/ports of its own.
  bridge:
    # Pinned by digest — same reasoning as the browser image above.
    image: alpine/socat@sha256:7f9a06753033f2b7de18edc2353f2c15153413d95a039163c6db270fc7a6c3b0
    container_name: agno-bridge
    restart: unless-stopped
    network_mode: "service:browser"
    depends_on:
      - browser
    command: TCP-LISTEN:8000,fork,reuseaddr,bind=127.0.0.1 TCP:100.72.169.40:8000

# Byline: Claude Code · Opus 4.8 · 2026-06-20
